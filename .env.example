# ==============================================================================
# FORTUNE HAVEN — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local for local development or set in production hosting platform.
# NEVER commit real secret keys, database credentials, or API tokens to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Canonical Domain & Public Settings
# ------------------------------------------------------------------------------
# Used for absolute URLs in metadata, sitemap.xml, robots.txt, and Open Graph.
NEXT_PUBLIC_SITE_URL=https://fortunehaven.com

# ------------------------------------------------------------------------------
# 2. Enquiry Email Dispatch (Server-Side Only)
# ------------------------------------------------------------------------------
# Provider options: Resend, Postmark, AWS SES, SendGrid, or custom SMTP.
# Set your chosen provider's API key or credentials below.
ENQUIRY_RECIPIENT_EMAIL=advisory@fortunehaven.com
EMAIL_FROM_ADDRESS=notifications@fortunehaven.com

# Example: Resend API Key (Optional)
# RESEND_API_KEY=re_your_api_key_here

# Example: SMTP Credentials (Optional alternative)
# SMTP_HOST=smtp.mailprovider.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password

# ------------------------------------------------------------------------------
# 3. CRM & Lead Pipeline (Optional / Production)
# ------------------------------------------------------------------------------
# CRM_WEBHOOK_URL=https://api.crmprovider.com/leads
# CRM_API_KEY=your_crm_api_key_here

# ------------------------------------------------------------------------------
# 4. Security & Rate Limiting
# ------------------------------------------------------------------------------
# Optional secret for protecting administrative diagnostic endpoints.
# ADMIN_API_SECRET=your_random_secure_token_here
